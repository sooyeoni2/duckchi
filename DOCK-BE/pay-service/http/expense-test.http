### 결제 관리 API 테스트 (Pay Service - 0317 최신화)

@pay-url = http://localhost:8082
@roomId = 1
@roomSessionId = 1

### 1. PAY-01: 계좌 거래 내역 조회
# 금융망 연동을 통해 최근 지출 내역을 가져옴.
POST {{pay-url}}/api/v1/expenses/account-history
Content-Type: application/json

{
  "accountNo": "0018341397102465"
}

> {%
 client.test("PAY-01 성공 확인", function() {
   client.assert(response.status === 200, "상태 코드가 200이 아님");
 });
%}

### 2. PAY-04: 결제 통합 등록 (N빵 케이스)
# 새로운 결제안을 등록함. 생성된 ID는 전역 변수에 저장하여 이후 단계에서 사용함.
POST {{pay-url}}/api/v1/rooms/{{roomId}}/expenses
Content-Type: application/json

{
  "roomId": {{roomId}},
  "roomSessionId": {{roomSessionId}},
  "title": "한우마당 (N빵 등록)",
  "totalAmount": 120000,
  "inputType": "MANUAL",
  "participants": [
    { "userId": 1, "userName": "강산천", "userTag": "#1A3", "splitAmount": 40000 },
    { "userId": 2, "userName": "정우주", "userTag": "#2B4", "splitAmount": 40000 },
    { "userId": 3, "userName": "류병선", "userTag": "#3C5", "splitAmount": 40000 }
  ]
}

> {%
 client.test("PAY-04 등록 성공 및 ID 캡처", function() {
   client.assert(response.status === 200, "등록 실패");
   client.global.set("createdExpenseId", response.body.data); 
 });
%}

### 3. PAY-05: 모임방 결제안 목록 조회
# 해당 방에 등록된 전체 결제안 내역을 확인하여 등록 여부를 교차 검증함.
GET {{pay-url}}/api/v1/rooms/{{roomId}}/expenses
Content-Type: application/json

### 4. PAY-05-Detail: 결제안 상세 조회
# 2단계에서 생성된 ID로 상세 정보를 조회함.
GET {{pay-url}}/api/v1/rooms/{{roomId}}/expenses/{{createdExpenseId}}
Content-Type: application/json

> {%
 client.test("PAY-05 상세 조회 확인", function() {
   client.assert(response.status === 200, "조회 실패");
   client.assert(response.body.data.expenseId == client.global.get("createdExpenseId"), "ID 불일치");
 });
%}

### 5. PAY-Modification: 결제안 수정 (내용 변경)
# 금액과 참여자를 변경하여 전체 덮어쓰기 수정을 진행함.
# 결과로 성공 메시지("결제안이 성공적으로 수정되었습니다.")를 반환받음.
PUT {{pay-url}}/api/v1/rooms/{{roomId}}/expenses/{{createdExpenseId}}
Content-Type: application/json

{
  "roomId": {{roomId}},
  "roomSessionId": {{roomSessionId}},
  "title": "한우마당 (금액 수정됨)",
  "totalAmount": 160000,
  "inputType": "MANUAL",
  "participants": [
    { "userId": 1, "userName": "강산천", "userTag": "#1A3", "splitAmount": 80000 },
    { "userId": 2, "userName": "정우주", "userTag": "#2B4", "splitAmount": 80000 }
  ]
}

> {%
 client.test("수정 성공 확인", function() {
   client.assert(response.status === 200, "수정 실패");
   client.assert(response.body.data === "결제안이 성공적으로 수정되었습니다.", "응답 메시지 불일치");
 });
%}

### 6. PAY-Modification-Check: 수정 결과 재확인
# 수정된 내용(제목, 금액 등)이 실제 반영되었는지 상세 조회를 통해 다시 확인함.
GET {{pay-url}}/api/v1/rooms/{{roomId}}/expenses/{{createdExpenseId}}
Content-Type: application/json

> {%
 client.test("수정 결과 데이터 정합성 확인", function() {
   client.assert(response.body.data.totalAmount === 150000, "수정된 금액이 반영되지 않음");
   client.assert(response.body.data.participants.length === 2, "수정된 참여자 수가 일치하지 않음");
 });
%}

### 7. PAY-06: 결제안 삭제
# 테스트를 위해 생성했던 결제안을 삭제함.
# 결과로 성공 메시지("결제안이 성공적으로 삭제되었습니다.")를 반환받음.
DELETE {{pay-url}}/api/v1/rooms/{{roomId}}/expenses/{{createdExpenseId}}
Content-Type: application/json

> {%
 client.test("삭제 성공 확인", function() {
   client.assert(response.status === 200, "삭제 실패");
   client.assert(response.body.data === "결제안이 성공적으로 삭제되었습니다.", "응답 메시지 불일치");
 });
%}

### 8. PAY-Delete-Check: 삭제 완료 확인
# 삭제된 ID로 재조회 시 404 에러 또는 데이터가 없음을 확인하여 최종 검증함.
GET {{pay-url}}/api/v1/rooms/{{roomId}}/expenses/{{createdExpenseId}}
Content-Type: application/json

> {%
 client.test("삭제 완료 확인 (조회 실패해야 함)", function() {
   client.assert(response.status === 404 || response.body.data === null, "삭제된 데이터가 여전히 조회됨");
 });
%}
