### 결제 관리 API 테스트 (Pay Service)

@gateway-url = http://localhost:8080
@pay-url = http://localhost:8082

### PAY-01: 계좌 거래 내역 조회
# 보안을 위해 POST Body로 계좌번호만 전달함.
POST {{pay-url}}/api/v1/expenses/account-history
X-User-Key: #본인 유저 키 입력
Content-Type: application/json

{
  "accountNo": "11111111"
}

> {%
 client.test("응답 상태 코드 200 확인", function() {
   client.assert(response.status === 200, "상태 코드가 200이 아님");
 });
 client.test("응답 데이터 구조 확인", function() {
   client.assert(response.body.success === true, "성공 여부가 true가 아님");
   client.assert(Array.isArray(response.body.data), "데이터가 리스트 형식이 아님");
 });
%}
