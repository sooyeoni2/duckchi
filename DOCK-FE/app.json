{
  "expo": {
    "name": "덕치",
    "slug": "duckduck",
    "scheme": "duckchi",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F2F3F5"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F2F3F5"
      },
      "package": "com.ssafy.duckduck"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ssafy.duckduck"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "영수증 이미지를 선택해 정산 요청을 만들기 위해 사진 접근 권한이 필요합니다.",
          "cameraPermission": "영수증을 촬영해 정산 요청을 만들기 위해 카메라 권한이 필요합니다."
        }
      ]
    ]
  }
}
